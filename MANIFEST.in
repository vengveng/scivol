include scivol/_csrc/*.h
recursive-include scivol/_native *.cpp *.hpp *.c *.h *.txt *.md
recursive-include scivol/_native/third_party *.json
include LICENSE
include README.md
include scivol/_core.pyi
include scivol/_native_core.pyi
include scivol/py.typed
exclude benchmark_optimizers.py
exclude next_steps.md
exclude prerelease.md
prune localdev
prune tests
include tests/test_native_joint_mean.py
include tests/egarch_precision_points.json
prune scivol/_devtools
