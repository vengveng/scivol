# Private, model-free header tests. Include inside core/CMakeLists.txt after
# ProductionFlags.cmake. No installed target or production source flags change.
if(BUILD_TESTING)
    set(coordinate_006_source "${CMAKE_CURRENT_SOURCE_DIR}/../tests/native/transfer_006_anchored_mean_chart.cpp")
    add_library(coordinate_006_anchored_probe SHARED "${coordinate_006_source}")
    add_executable(coordinate_006_anchored "${coordinate_006_source}")
    target_compile_definitions(coordinate_006_anchored PRIVATE ANCHORED_CHART_EXECUTABLE)
    add_executable(coordinate_006_residual ../tests/native/transfer_006_residual_mean_chart.cpp)
    add_library(coordinate_006_residual_audit OBJECT ../tests/native/transfer_006_residual_mean_chart.cpp)
    target_compile_definitions(coordinate_006_residual_audit PRIVATE VLK_RESIDUAL_CHART_AUDIT_ONLY)
    add_library(coordinate_006_probe SHARED ../tests/bridges/mean_coordinates_006_probe.cpp)
    add_executable(coordinate_006_arena_lifetime ../tests/native/test_coordinate_006_arena_lifetime.cpp)
    foreach(target IN ITEMS coordinate_006_anchored_probe coordinate_006_anchored
            coordinate_006_residual coordinate_006_residual_audit coordinate_006_probe
            coordinate_006_arena_lifetime)
        target_compile_features(${target} PRIVATE cxx_std_20)
        target_include_directories(${target} PRIVATE include src
            src/math/power/third_party/boost src/math/power/third_party/tlfloat)
        scivolapi_production_flags(${target})
        set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
        if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
            target_compile_options(${target} PRIVATE -fno-exceptions -fno-rtti -UNDEBUG -fstack-usage)
            if(SCIVOLAPI_NATIVE_ARCH)
                target_compile_options(${target} PRIVATE -funroll-loops -march=native)
            endif()
        endif()
    endforeach()
    add_test(NAME coordinate_006_anchored COMMAND coordinate_006_anchored)
    set_tests_properties(coordinate_006_anchored PROPERTIES TIMEOUT 110)
    add_test(NAME coordinate_006_arena_lifetime COMMAND coordinate_006_arena_lifetime)
    set_tests_properties(coordinate_006_arena_lifetime PROPERTIES TIMEOUT 30)
    foreach(mode IN ITEMS intentions lifecycle guards analytic poisoned)
        add_test(NAME coordinate_006_residual_${mode} COMMAND coordinate_006_residual ${mode})
        set_tests_properties(coordinate_006_residual_${mode} PROPERTIES TIMEOUT 115)
    endforeach()
endif()
